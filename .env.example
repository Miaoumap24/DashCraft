# ==============================================================================
# DashCraft Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Web Dashboard Server Settings
# ------------------------------------------------------------------------------
# IP address to bind the web server (0.0.0.0 allows LAN access)
HOST=0.0.0.0

# Port for the web dashboard UI
PORT=8000

# Automatically open DashCraft in your default browser on startup (true/false)
AUTO_OPEN_BROWSER=true

# ------------------------------------------------------------------------------
# Minecraft Server Target Settings
# ------------------------------------------------------------------------------
# IP or hostname of the Minecraft server to monitor
MC_SERVER_IP=127.0.0.1

# Query/Ping port of the Minecraft server (Default Java Edition: 25565)
MC_SERVER_PORT=25565

# ------------------------------------------------------------------------------
# Minecraft RCON Remote Console Settings
# ------------------------------------------------------------------------------
# Enable or disable RCON command console execution (true/false)
RCON_ENABLED=true

# RCON Port configured in your Minecraft server.properties (Default: 25575)
RCON_PORT=25575

# RCON Password configured in your server.properties (rcon.password=...)
RCON_PASSWORD=
